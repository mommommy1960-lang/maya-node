{
  "name": "maya-node",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maya-mail-staging",
      "database_id": "b9a92d33-b8d5-4438-8f3e-9d7c3e06f0b2"
    }
  ],
  "vars": {
    "SEND_ENABLED": "true",
    "MAIL_FROM": "mommommy1960@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
