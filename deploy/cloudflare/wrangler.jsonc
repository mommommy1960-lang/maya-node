{
  "name": "maya-mail-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [{"binding":"DB", "database_name":"maya-mail-staging", "database_id":"REPLACE_WITH_DATABASE_ID"}],
  "vars": {"SEND_ENABLED":"false"},
  "observability": {"enabled":true}
}
